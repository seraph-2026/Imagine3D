macro "macros"
	elem 
		name = "F1"
		command = "map3dOnly"
	elem 
		name = "F2"
		command = "map3dAndOutput"
	elem 
		name = "F3"
		command = "fullscreen"


window "map-window"
	elem "map-window"
		type = MAIN
		pos = 291,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		background-color = none
		is-visible = false
		saved-params = "pos;size;is-minimized;is-maximized"
		title = "2D Minimap"
		statusbar = false
		can-minimize = false
		outer-size = 656x519
		outer-pos = 291,0
		inner-pos = 8,31
		screen-size = 1920x1032
	elem "map"
		type = MAP
		pos = 0,0
		size = 640x480
		anchor1 = 0,0
		anchor2 = 100,100
		saved-params = "zoom;letterbox;zoom-mode"

window "output-window"
	elem "output-window"
		type = MAIN
		pos = 291,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		background-color = none
		is-visible = false
		saved-params = "pos;size;is-minimized;is-maximized"
		outer-size = 656x538
		outer-pos = 291,0
		inner-pos = 8,31
		screen-size = 1920x1032
	elem "output"
		type = OUTPUT
		pos = 0,0
		size = 640x496
		anchor1 = -1,-1
		anchor2 = -1,-1
		is-default = true
		saved-params = "max-lines"

window "window"
	elem "window"
		type = MAIN
		pos = 291,0
		size = 960x655
		anchor1 = -1,-1
		anchor2 = -1,-1
		background-color = #000000
		is-default = true
		saved-params = "pos;size;is-minimized;is-maximized=.options"
		title = "Imagine3D"
		statusbar = false
		macro = "macros"
		outer-size = 976x694
		outer-pos = 291,0
		inner-size = 960x655
		inner-pos = 8,31
		screen-size = 1920x1032
	elem "imagine-3d-browser"
		type = BROWSER
		pos = 0,0
		size = 960x655
		anchor1 = 0,0
		anchor2 = 100,100
		background-color = none
		saved-params = ""
		inner-background-color = none

